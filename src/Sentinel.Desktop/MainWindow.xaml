<Window x:Class="Sentinel.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sentinel DFIR | Windows Security Monitor" Width="1220" Height="790"
        MinWidth="900" MinHeight="620" Background="#0E1728" Foreground="#E8F1FF"
        FontFamily="Segoe UI">
    <Window.Resources>
      <Style TargetType="Button">
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>
      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="#E8F1FF"/>
      </Style>
      <Style TargetType="DataGrid">
        <Setter Property="Background" Value="#152237"/>
        <Setter Property="Foreground" Value="#E8F1FF"/>
        <Setter Property="BorderBrush" Value="#35485F"/>
        <Setter Property="RowBackground" Value="#152237"/>
        <Setter Property="AlternatingRowBackground" Value="#1B2C45"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
      </Style>
    </Window.Resources>
    <Grid Margin="22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,18">
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="SENTINEL DFIR" FontSize="27" FontWeight="Bold" Foreground="#4DE3C4"/>
          <TextBlock Text="Local security monitoring • research prototype v0.1" Foreground="#A4BAD4" FontSize="13"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Refresh" Click="Refresh_Click"/>
          <Button Content="Export HTML Report" Click="ExportReport_Click"/>
        </StackPanel>
      </DockPanel>
      <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
        <Border Background="#192A41" CornerRadius="9" Padding="14" Margin="4">
          <StackPanel><TextBlock Text="TOTAL EVENTS" Foreground="#A4BAD4"/>
          <TextBlock x:Name="TotalText" Text="0" FontSize="24" FontWeight="Bold"/></StackPanel>
        </Border>
        <Border Background="#192A41" CornerRadius="9" Padding="14" Margin="4">
          <StackPanel><TextBlock Text="HIGH / CRITICAL" Foreground="#A4BAD4"/>
          <TextBlock x:Name="HighText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#FFAD76"/></StackPanel>
        </Border>
        <Border Background="#192A41" CornerRadius="9" Padding="14" Margin="4">
          <StackPanel><TextBlock Text="NETWORK EVENTS" Foreground="#A4BAD4"/>
          <TextBlock x:Name="NetworkText" Text="0" FontSize="24" FontWeight="Bold"/></StackPanel>
        </Border>
        <Border Background="#192A41" CornerRadius="9" Padding="14" Margin="4">
          <StackPanel><TextBlock Text="AGENT STATUS" Foreground="#A4BAD4"/>
          <TextBlock x:Name="StatusText" Text="Unknown" FontSize="18" FontWeight="Bold"/></StackPanel>
        </Border>
      </UniformGrid>
      <TabControl Grid.Row="2" Background="#152237" Foreground="#0E1728">
        <TabItem Header="Security Events" Background="#1B2C45">
          <Grid Margin="10" Background="#152237">
            <Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
            <DataGrid x:Name="EventsGrid" Grid.Row="0" AutoGenerateColumns="False"
                      SelectionChanged="EventsGrid_SelectionChanged">
              <DataGrid.Columns>
                <DataGridTextColumn Header="UTC Time" Binding="{Binding TimestampUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="175"/>
                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/>
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="110"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Risk" Binding="{Binding RiskScore}" Width="60"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBox x:Name="DetailsBox" Grid.Row="1" Margin="0,10,0,0" Padding="10"
                     Text="Select an event to inspect its evidence." TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     IsReadOnly="True" Background="#0E1728" Foreground="#D8E9FF"
                     FontFamily="Consolas" FontSize="12"/>
          </Grid>
        </TabItem>
        <TabItem Header="Live Processes">
          <Grid Margin="10" Background="#152237">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
              <Button Content="Refresh Processes" Click="RefreshProcesses_Click"/>
              <Button Content="End Selected Process (manual)" Click="EndProcess_Click"/>
            </StackPanel>
            <DataGrid x:Name="ProcessesGrid" Grid.Row="1" AutoGenerateColumns="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="90"/>
                <DataGridTextColumn Header="Memory MB" Binding="{Binding MemoryMb}" Width="130"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>
      </TabControl>
      <TextBlock Grid.Row="3" x:Name="FooterText" Foreground="#A4BAD4" Margin="0,13,0,0"
                 Text="Read-only telemetry by default. Manual actions require explicit confirmation."/>
    </Grid>
</Window>
